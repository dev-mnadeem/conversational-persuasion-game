# --- Which brain answers -------------------------------------------------
# local  (default) deterministic, offline, no key required
# venice           hosted models via the Venice AI OpenAI-compatible API
DOORMAN_PROVIDER=local

# Required only when DOORMAN_PROVIDER=venice. Read server side, never sent
# to the browser.
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
DOORMAN_JUDGE_MODEL=qwen3-next-80b
DOORMAN_DOORMAN_MODEL=qwen3-4b
DOORMAN_REQUEST_TIMEOUT=60

# --- Optional text-to-speech (venice provider only) ----------------------
DOORMAN_TTS_ENABLED=false
DOORMAN_TTS_MODEL=tts-kokoro
DOORMAN_TTS_VOICE=am_adam

# --- Server --------------------------------------------------------------
DOORMAN_CORS_ORIGINS=http://localhost:7322,http://127.0.0.1:7322
DOORMAN_SESSIONS_DIR=sessions
DOORMAN_SESSION_CACHE_SIZE=256
DOORMAN_MAX_MESSAGE_CHARS=500

# Set to enable GET /api/admin/sessions, sent as the X-Admin-Token header.
DOORMAN_ADMIN_TOKEN=
